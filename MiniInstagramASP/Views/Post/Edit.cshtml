@using Microsoft.AspNetCore.Mvc.ModelBinding
@model PostCreateViewModel

@{
    var isEdit = Model != null && Model.Id != 0;
    ViewData["Title"] = isEdit ? "Upravit příspěvek" : "Vytvořit příspěvek";
}

<div class="container mt-4">
    
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm p-4 mb-4">
                <h2 class="mb-3 text-center">@ViewData["Title"]</h2>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                
                <form asp-controller="Post" asp-action="Post" id="createPostForm" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id"/>
                    
                    <div class="form-floating mb-3">
                        <textarea asp-for="Text" class="form-control" placeholder="Text příspěvku" style="height: 120px;"></textarea>
                        <label asp-for="Text">Text příspěvku</label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Image" class="form-label">Obrázek</label>
                        <input asp-for="Image" type="file" class="form-control" onchange="previewImage(this)"/>
                    </div>

                    <button id="createPostSubmit" type="submit" class="w-100 btn btn-lg btn-primary mb-3">@ViewData["Title"]</button>
                </form>

                <div class="text-center">
                    @if (Model.ExistingImagePath != null)
                    {
                        <img id="imagePreview" src="/image/@Model.ExistingImagePath" class="img-fluid rounded shadow-sm" style="max-height: 300px;" alt=""/>
                    }
                    else
                    {
                        <img id="imagePreview" class="img-fluid rounded shadow-sm d-none" style="max-height: 300px;" alt=""/>
                    }
                </div>

                @if (isEdit)
                {
                    <form asp-controller="Post"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Opravdu chcete smazat tento příspěvek?');"
                          class="mt-3">
                        <button type="submit" class="w-100 btn btn-lg btn-danger">Smazat</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>