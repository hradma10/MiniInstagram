@using Microsoft.AspNetCore.Mvc.ModelBinding
@model MainPageModel

@{
    ViewData["Title"] = "Feed";
}
<div class="container">
    <div class="d-flex justify-content-start mb-3">
        @if (Model.User != null)
        {
            <a class="btn btn-primary" asp-area="" asp-controller="Post" asp-action="Edit">
                Vytvořit příspěvek
            </a>
        }
    </div>
    <div class="d-flex justify-content-center mt-3">

        <div class="col-12 col-md-8 col-lg-6">

            <h2 class="mb-4 text-center">Feed</h2>

            @foreach (var post in Model.Feed)
            {
                var viewData = new ViewDataDictionary(
                    new EmptyModelMetadataProvider(),
                    ViewData.ModelState)
                {
                    ["CurrentUserId"] = Model.User?.Id,
                    ["WithComments"] = false
                };

                @await Html.PartialAsync("_Post", post, viewData)
            }

        </div>
    </div>
</div>
@section Scripts
{
    <script src="~/js/post_actions.js"></script>
}